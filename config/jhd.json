{
  "organization": "Jason-Holt-Digital",
  "execution_queue": "github",
  "status_repository": "Jason-Holt-Digital/jhd-skills",
  "local_model": "custom:droidproxy:gpt-6.1-sol",
  "assessment_effort": "high",
  "remediation_effort": "xhigh",
  "trusted_associations": ["OWNER", "MEMBER", "COLLABORATOR"],
  "trusted_bots": ["factory-droid[bot]"],
  "production_approval": "human",
  "automatic_release_merges": false,
  "automatic_tag_creation": false,
  "automatic_production_deployments": false,
  "automation_policy": {
    "ticket_to_pr": {"state": "deferred", "schedule": null},
    "source_intake": {"state": "deferred", "schedule": null},
    "health": {"schedule": "0 3 * * 3", "max_pull_requests": 1},
    "digest": {"schedule": "30 7 * * 1", "lookback_days": 7},
    "readiness": {"schedule": "0 3 1 * *", "max_repositories": 2, "remediation": false},
    "triage": {"trigger": "issues.opened", "implementation": false, "automatic_ready": false}
  },
  "ci_steward": {
    "max_retries": 1,
    "max_fix_commits": 2,
    "max_invocations": 10,
    "watch_ai_workflows": false,
    "watch_release_workflows": false
  },
  "queue_labels": {
    "ready": "automation:ready",
    "working": "automation:working",
    "blocked": "automation:blocked",
    "awaiting_release": "automation:awaiting-release",
    "canary": "automation:canary",
    "paused": "automation:paused"
  },
  "source_ownership": {
    "github": ["execution_status", "pull_requests", "verification"],
    "linear": ["product_scope", "acceptance_criteria", "priority"],
    "sentry": ["error_evidence", "affected_releases", "release_resolution"]
  },
  "sources": {
    "linear": {
      "state": "prepared",
      "workspace_verified": false,
      "workspace_id": null,
      "team_mappings": []
    },
    "sentry": {
      "state": "prepared",
      "organization_slug": "jason-holt-digital-llc",
      "writeback_verified": false,
      "native_integration_verified": false,
      "project_mappings": [
        {
          "project_id": "4508302395899904",
          "project_slug": "mythic-gme-mobile",
          "repository": "MythicGME2e",
          "mapping_verified": true
        }
      ]
    },
    "posthog": {"state": "deferred", "minimum_product_version": "1.7"}
  },
  "merge_exclusions": [
    ".github/**",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/.factory/settings.json",
    "**/release-please-config.json",
    "**/.release-please-manifest.json",
    "**/pubspec.yaml",
    "**/codemagic.yaml",
    "**/migrations/**",
    "**/secrets/**"
  ],
  "repositories": [
    {"name": "MythicGME2e", "path": "MythicGME2e", "kind": "flutter", "release": "notes-and-store", "state": "prepared", "automerge": false, "native_qa_required": true, "deployment_audited": false},
    {"name": "mythic_gme_apps", "path": "mythic_gme_apps", "kind": "flutter-workspace", "release": "independent-components", "state": "prepared", "automerge": false, "native_qa_required": true, "deployment_audited": false},
    {"name": "tome_keeper", "path": "tome_keeper", "kind": "flutter", "release": "existing-release-please", "state": "prepared", "automerge": false, "native_qa_required": true, "deployment_audited": false},
    {"name": "mythic-dice-parser", "path": "mythic-dice-parser", "kind": "dart-library", "release": "package", "state": "prepared", "automerge": false, "native_qa_required": false, "deployment_audited": false},
    {"name": "icloud_storage_plus", "path": "icloud_storage_plus", "kind": "flutter-plugin", "release": "tag-pubdev", "state": "prepared", "automerge": false, "native_qa_required": true, "deployment_audited": false, "publish_environment": "pub.dev", "human_gate_configured": true, "human_gate_canary_verified": true},
    {"name": "jhd-jaspr", "path": "websites/jhd-jaspr", "kind": "dart-web", "release": "notes-and-site", "state": "prepared", "automerge": false, "native_qa_required": false, "deployment_audited": false},
    {"name": "jhd-astro", "path": "websites/jhd-astro", "kind": "typescript-web", "release": "site", "state": "prepared", "automerge": false, "native_qa_required": false, "deployment_audited": false},
    {"name": "ac-deck-builder", "path": "ac-deck-builder", "kind": "flutter", "release": "none", "state": "prepared", "automerge": false, "native_qa_required": true, "deployment_audited": false},
    {"name": "broken-empires-creator", "path": "broken-empires-creator", "kind": "typescript-web", "release": "site", "state": "prepared", "automerge": false, "native_qa_required": false, "deployment_audited": false},
    {"name": "jhd-skills", "path": "jhd-skills", "kind": "skills", "release": "none", "state": "prepared", "automerge": false, "native_qa_required": false, "deployment_audited": false},
    {"name": "agent-skills", "path": "agent-skills", "kind": "skills", "release": "none", "state": "prepared", "automerge": false, "native_qa_required": false, "deployment_audited": false},
    {"name": "Mythic-Source-Materials", "path": "Mythic-Source-Materials", "kind": "sources", "release": "none", "state": "prepared", "automerge": false, "native_qa_required": false, "deployment_audited": false},
    {"name": "factory-droid-workflows", "path": "factory-droid-workflows", "kind": "automation", "release": "none", "state": "prepared", "automerge": false, "native_qa_required": false, "deployment_audited": false}
  ]
}
